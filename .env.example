# ---- Google Gemini ----
# Get an API key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_VERSION=v1beta
GEMINI_MAX_OUTPUT_TOKENS=500
GEMINI_THINKING_BUDGET=0

# ---- SMTP / mail account ----
# Gmail example: smtp.gmail.com + an App Password (not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
MAIL_USERNAME=you@example.com
MAIL_PASSWORD=your-app-password
# Leave MAIL_FROM empty to reuse MAIL_USERNAME
MAIL_FROM=
# Used as the From display name and the signature at the end of every email
SENDER_NAME=Your Name
MAIL_STARTTLS=True
MAIL_SSL_TLS=False
